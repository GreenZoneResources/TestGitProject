{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "BulkReversalConnection": "Server=(localdb)\\mssqllocaldb;Database=BulkReversalDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "SingleSignOnConnection": ""
  },

  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false
  },

  "BusinessRules": {
    "MaxRecordsPerFile": 500,
    "MaxTransactionAgeDays": 365
  },

  "ProviderIntegration": {
    "MaxItemsPerPoll": 200,
    "Currency": "NGN"
  },

  "TransferService": {
    "Enabled": false,
    "BaseUrl": "",
    "GetTransactionByReference": "/api/transactions/reference",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "MaxConcurrentRequests": 10
  },

  "Sso": {
    "AccessTokenCookieName": "access-token",
    "AppRolesClaimName": "appRoles",
    "UseDatabaseTokenSettings": true,
    "ConnectionStringName": "SingleSignOnConnection",
    "Jwt": {
      "Issuer": "",
      "Audience": "",
      "Key": ""
    }
  },

  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 25,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "bulkreversal-noreply@bank.local",
    "FromName": "BulkReversal Settlement Portal",
    "PortalBaseUrl": ""
  },

  "ProviderApiKey": {
    "HeaderName": "X-API-Key",
    "ApiKeys": []
  },

  "RateLimiting": {
    "Provider": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },

  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": []
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Swagger": {
    "Enabled": true
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bulkreversal-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
